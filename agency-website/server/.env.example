# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Your Zoho Mail address that will authenticate and send these emails.
ZOHO_EMAIL=abdulbasit@abaryx.com

# An app-specific password, NOT your regular Zoho login password.
# Generate one at: Zoho Accounts -> Security -> App Passwords
# (https://accounts.zoho.com/home#security/app-passwords)
ZOHO_APP_PASSWORD=your_16_char_app_password

# Only change these if Zoho's docs say your account uses a different
# data center (e.g. smtp.zoho.eu, smtp.zoho.in).
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465

# Display name used in the "From" header (the address itself must stay
# ZOHO_EMAIL above — Zoho rejects mail sent from an address it doesn't
# recognize as yours).
FROM_NAME=Abraxis Solutions

# Where the "new project inquiry" notification email is sent.
OWNER_EMAIL=abdulbasit@abaryx.com

# Port the server listens on. Render sets this automatically in
# production — only used for local development.
PORT=3001

# Origin allowed to call this API. Use "*" only for local testing —
# set this to https://abaryx.com once deployed.
ALLOWED_ORIGIN=*
